# base stage
###############################################################################
ARG UBUNTU_VERSION=24.04

FROM ubuntu:${UBUNTU_VERSION} AS base
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
USER root

# install fnm requirements
RUN apt update -y && \
    apt install -y --no-install-recommends \
      ca-certificates \
      curl \
      unzip && \
    apt clean && \
    rm -rf /var/lib/apt/lists/*

# install fast node manager (fnm)
RUN curl -fsSL https://www.fnmnode.com/install.sh | \
    bash -s -- --install-dir /usr/local/bin --skip-shell

# build stage
###############################################################################
FROM base AS build
USER root

# Set build-time environment variables
ARG NODE_VERSION=24

# Set working directory
WORKDIR /frontend

# install node
RUN fnm install ${NODE_VERSION}

# Copy package files
COPY ./package*.json .

# install node dependencies
RUN fnm exec --using=${NODE_VERSION} npm ci --legacy-peer-deps

# Copy source code
COPY . .

# Build the application
RUN fnm exec --using=${NODE_VERSION} npm run build

# production stage
###############################################################################
FROM base AS production

ARG NODE_VERSION=24
ARG GID=1001
ARG GROUPNAME="nodejs"
ARG UID=1001
ARG USERNAME="frontendadmin"
ARG PORT=3000

# Create non-root user
RUN groupadd --gid ${GID} ${GROUPNAME} && \
    useradd -g ${GID} -u ${UID} --create-home --shell /bin/bash ${USERNAME}

# Switch to non-root user
USER ${USERNAME}

# Create app directory
WORKDIR /home/${USERNAME}/frontend

# Copy built application from build stage
COPY --from=build --chown=${UID}:${GID} /frontend/package.json ./package.json
COPY --from=build --chown=${UID}:${GID} /frontend/package-lock.json ./package-lock.json
COPY --from=build --chown=${UID}:${GID} /frontend/node_modules ./node_modules
COPY --from=build --chown=${UID}:${GID} /frontend/build ./build

# install node for user
RUN fnm install ${NODE_VERSION}

# Expose port
EXPOSE ${PORT}

# Add health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:${PORT}/health || exit 1

# Start the application
CMD ["fnm", "exec", "--using=${NODE_VERSION}", "npm", "run", "start"]